# ================================================================
# XtraEarn Platform — Production Environment Configuration
# NEVER commit the actual .env file with production secrets to Git.
# Keep all database credentials strictly server-side.
# ================================================================

# Application Server
PORT=3000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_random_key_here_min_64_characters
JWT_EXPIRES_IN=7d

# MySQL Production Database Configuration
# Charset: utf8mb4 / Collation: utf8mb4_unicode_ci
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=xtraearn

# Email Gateway (SendGrid / Brevo SMTP)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@xtraearn.com
SENDGRID_FROM_NAME="XtraEarn Platform"

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_FROM_EMAIL=no-reply@xtraearn.com
